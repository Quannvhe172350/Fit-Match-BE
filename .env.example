# FitMatch Backend — biến môi trường
# Copy thành .env (git-ignored) rồi điền giá trị thật, hoặc export trực tiếp.
# Ghi chú: (*) = BẮT BUỘC ở profile dev/prod (không có default).

# ===== Database (MariaDB) =====
DB_URL=jdbc:mariadb://localhost:3306/fitmatch?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=root123

# ===== JWT (*) =====
# Sinh nhanh: openssl rand -base64 48
JWT_SECRET=
# JWT_ACCESS_EXPIRATION=3600000        # 1h (ms)
# JWT_REFRESH_EXPIRATION=604800000     # 7d (ms)

# ===== Server / URL =====
# SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
# Prod: đặt origin FE cụ thể, KHÔNG để *
CORS_ALLOWED_ORIGINS=*

# ===== Mail (không set MAIL_HOST -> dùng LoggingEmailService, chỉ log không gửi) =====
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@fitmatch.app

# ===== Storage (GCS_ENABLED=false -> lưu file local ./uploads) =====
GCS_ENABLED=false
# GCS_BUCKET=fit-match
# GCP_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

# ===== Thanh toán VietQR + Casso (BẮT BUỘC ở prod để nhận tiền thật) =====
# VIETQR_BANK_BIN=970415
# VIETQR_ACCOUNT_NO=
# VIETQR_ACCOUNT_NAME=
# VIETQR_TEMPLATE=compact2
# Secret rỗng -> BE từ chối mọi webhook Casso (fail-safe)
# Lấy từ trang quản lý Tích hợp Webhook V2 trên Casso
# CASSO_WEBHOOK_SECRET=

# ===== Tham số nghiệp vụ (đều có default) =====
# PAYMENT_ORDER_TTL_HOURS=24
# DISPUTE_OPEN_WINDOW_DAYS=14

# ===== Integration test migration (tùy chọn) =====
# IT_DB_URL=jdbc:mariadb://localhost:3306
# IT_DB_USERNAME=root
# IT_DB_PASSWORD=root123
