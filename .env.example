# FitMatch Backend — biến môi trường
# Copy thành .env (git-ignored) rồi điền giá trị thật, hoặc export trực tiếp.
# Ghi chú: (*) = BẮT BUỘC ở profile dev/prod (không có default).

# ===== Database (MariaDB) =====
DB_URL=jdbc:mariadb://localhost:3306/fitmatch?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=root123

# ===== JWT (*) =====
# Sinh nhanh: openssl rand -base64 48
JWT_SECRET=
# JWT_ACCESS_EXPIRATION=3600000        # 1h (ms)
# JWT_REFRESH_EXPIRATION=604800000     # 7d (ms)

# ===== Server / URL =====
# SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
# Prod: đặt origin FE cụ thể, KHÔNG để *
CORS_ALLOWED_ORIGINS=*

# ===== Mail (không set MAIL_HOST -> dùng LoggingEmailService, chỉ log không gửi) =====
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@fitmatch.app

# ===== Đăng nhập Google (UC-003) =====
# OAuth 2.0 Client ID loại "Web application" (Google Cloud Console > APIs & Services
# > Credentials). Phải TRÙNG với NEXT_PUBLIC_GOOGLE_CLIENT_ID của FE — BE dùng nó để
# kiểm tra claim `aud` của ID token. Không cần client secret.
# Nhiều client (web/Android/iOS) thì liệt kê cách nhau bằng dấu phẩy.
# Để trống = tắt luồng Google: /api/auth/google trả 503, FE ẩn nút.
GOOGLE_OAUTH_CLIENT_IDS=

# ===== Storage: Google Cloud Storage (GCS_ENABLED=false -> lưu file local ./uploads) =====
# Local ./uploads CHỈ dùng cho máy dev: file mất khi redeploy container và không
# chia sẻ được giữa nhiều instance. Mọi môi trường thật phải bật GCS.
GCS_ENABLED=false
# Mỗi môi trường một bucket riêng — KHÔNG dùng chung UAT/Production:
#   fitmatch-dev / fitmatch-uat / fitmatch-prod
# GCS_BUCKET=your-bucket-name
# GCP_PROJECT_ID=your-project-id
#
# Xác thực — ƯU TIÊN Application Default Credentials:
#   * Chạy trên Google Cloud (Cloud Run/GKE/GCE): để TRỐNG biến dưới đây và gán
#     service account cho workload (Workload Identity). Không có key nào tồn tại
#     dưới dạng file -> không có gì để rò rỉ.
#   * Chạy local: `gcloud auth application-default login`, hoặc trỏ tới file key
#     nằm NGOÀI repo. TUYỆT ĐỐI không commit service account JSON.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/sa-key.json
#
# Service account chỉ cần roles/storage.objectAdmin trên đúng bucket đó.
# Muốn dùng signed URL với ADC thì thêm roles/iam.serviceAccountTokenCreator.

# ===== Ảnh / Media (V64) =====
# public-read=true: bucket cho đọc ẩn danh (IAM allUsers -> roles/storage.objectViewer),
#   URL cố định, đặt được CDN phía trước. Hợp với ảnh marketplace.
# public-read=false: bucket đóng, mọi URL đều được BE ký lại, hết hạn sau N phút.
#   FE không bao giờ nhận credentials trong cả hai chế độ.
# MEDIA_PUBLIC_READ=true
# MEDIA_SIGNED_URL_TTL_MINUTES=60
MAX_IMAGE_SIZE_MB=5
# MAX_IMAGES_PER_ENTITY=10
# MAX_FILES_PER_REQUEST=10
# ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
# Hạn mức tầng servlet, phải LỚN HƠN MAX_IMAGE_SIZE_MB
# MAX_UPLOAD_FILE_SIZE=12MB
# MAX_UPLOAD_REQUEST_SIZE=80MB
# Cạnh dài tối đa của ảnh thu nhỏ; 0 = không sinh thumbnail
# MEDIA_THUMBNAIL_MAX_EDGE=400
# Ảnh đã upload nhưng người dùng bỏ dở form -> job dọn sau ngần này giờ
# MEDIA_ORPHAN_RETENTION_HOURS=24
# MEDIA_CLEANUP_JOB=true
# MEDIA_CLEANUP_CRON=0 15 3 * * *

# ===== Thanh toán VietQR + Casso (BẮT BUỘC ở prod để nhận tiền thật) =====
# VIETQR_BANK_BIN=970415
# VIETQR_ACCOUNT_NO=
# VIETQR_ACCOUNT_NAME=
# VIETQR_TEMPLATE=compact2
# Secret rỗng -> BE từ chối mọi webhook Casso (fail-safe)
# Lấy từ trang quản lý Tích hợp Webhook V2 trên Casso
# CASSO_WEBHOOK_SECRET=

# ===== Tham số nghiệp vụ (đều có default) =====
# PAYMENT_ORDER_TTL_HOURS=24
# DISPUTE_OPEN_WINDOW_DAYS=14

# ===== Integration test migration (tùy chọn) =====
# IT_DB_URL=jdbc:mariadb://localhost:3306
# IT_DB_USERNAME=root
# IT_DB_PASSWORD=root123
